{
  "name": "keycloak",
  "version": "0.0.4",
  "lockfileVersion": 2,
  "requires": true,
  "packages": {},
  "devDependencies": {
    "copyfiles": "2.4.1",
    "rimraf": "3.0.2"
  },
  "dependencies": {
    "@gemeente-denhaag/keycloak": "0.1.1-alpha.236"
  },
  "scripts": {
    "dev": "bash ./run_script.sh",
    "clean": "rimraf node_modules",
    "copy": "copyfiles --flat --verbose ./node_modules/@gemeente-denhaag/keycloak/dist/index.css ./denhaagtheme/login/resources/css",
    "release": "git tag v$npm_package_version && git push origin v$npm_package_version",
    "preinstall": "npx only-allow pnpm"
  }
}
